{
  // ── The important one ──────────────────────────────────────────────────────
  // ktlint owns Kotlin layout and import order, run through Gradle:
  // `./gradlew spotlessApply`. The Kotlin extension's own formatter is ktfmt, which
  // disagrees with ktlint on most wrapped lines, so format-on-save stays off here and
  // organize-imports with it — either would leave a diff `spotlessCheck` then rejects.
  // See CONTRIBUTING.md → Conventions.
  "[kotlin]": {
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "never"
    }
  },

  // Gradle output and caches: hundreds of megabytes that regenerate constantly. Watching
  // them costs a file handle per entry and gains nothing; git already ignores all three.
  "files.watcherExclude": {
    "**/build/**": true,
    "**/.gradle/**": true,
    "**/.kotlin/**": true
  },
  "search.exclude": {
    "**/build": true,
    "**/.gradle": true,
    "**/.kotlin": true
  },

  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  // parity.md and the READMEs use long lines and inline HTML deliberately.
  "[markdown]": {
    "editor.formatOnSave": false,
    "files.trimTrailingWhitespace": false
  },
  "python-envs.defaultEnvManager": "ms-python.python:system"
}
