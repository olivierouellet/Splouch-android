<?xml version="1.0" encoding="utf-8"?>
<!-- The window behind Compose. Dark, and not the device's choice: every meet theme an
     operator ships paints a dark board (app.md T-01), so the picker follows the board
     rather than the system until there is a light board to match. See `SplouchTheme`. -->
<resources>
    <style name="Theme.Splouch" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
