<?xml version="1.0" encoding="utf-8"?>
<!-- The window behind Compose. It follows the device's light or dark (DayNight) rather
     than forcing black: app.md T-01 starts at a meet's `settings`, and there is no meet
     behind the picker, so the chrome there is the platform's. A meet's own background is
     painted by `BoardTheme`, over this one. -->
<resources>
    <style name="Theme.Splouch" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
