<?xml version="1.0" encoding="utf-8"?>
<!-- app.md T-05: a word the web page also shows belongs to the server and arrives in
     GET /i18n/{lang} → mobile (tabs, empty states, the filter sheet, the picker's chrome).
     A word about the app or the device belongs here and is translated natively: the
     server sheet, connection and address errors, and the standard buttons. -->
<resources>
    <string name="app_name">Splouch</string>

    <!-- Server sheet (app.md P-11..P-13) -->
    <string name="server">Server</string>
    <string name="add_server">Add a server</string>
    <string name="server_placeholder">https://… or http://splouch.local:5000</string>
    <string name="nearby">Nearby</string>
    <string name="remove">Remove</string>
    <string name="checking">Checking…</string>

    <!-- Connection and address errors -->
    <string name="server_unreachable">Cannot reach this server</string>
    <string name="not_splouch">Not a Splouch server</string>
    <string name="invalid_address">Enter a valid address</string>
    <string name="cleartext_not_local">Plain http is only allowed for .local names</string>
    <string name="meet_gone">This meet is no longer available</string>

    <!-- Added from a QR code (P-16). The prompt is the whole of the security here: a code
         on a pool wall names an address and the reader is the one who agrees to it, so the
         question shows the origin in full and neither button is the default. -->
    <string name="add_server_question">Add this server?</string>
    <string name="switch_server_question">Switch to this server?</string>
    <string name="add">Add</string>
    <string name="switch_to">Switch</string>
    <string name="cannot_add_server">Cannot add this server</string>
    <string name="bad_server_link">This link does not carry a server address</string>

    <!-- Standard buttons -->
    <string name="cancel">Cancel</string>
    <string name="done">Done</string>
    <string name="ok">OK</string>
    <string name="retry">Retry</string>
    <string name="clear">Clear</string>
    <string name="close">Close</string>
    <string name="undo">Undo</string>
    <string name="server_removed">Server removed</string>

    <!-- Appearance (P-15). Light and dark are about the device, not about anything a
         web page shows, so these are the app's words and no server serves them. -->
    <string name="appearance">Appearance</string>
    <string name="appearance_dark">Dark</string>
    <string name="appearance_light">Light</string>
    <string name="appearance_auto">Automatic</string>
    <string name="more_options">More options</string>

    <!-- L-23, the screen reader only: what the number in the delta cell is while a lane is
         still swimming, spoken as "laps 3". The wire names the six columns and stops, so the
         lap has no served word to keep and this one is the app's. -->
    <string name="laps">laps</string>
</resources>
