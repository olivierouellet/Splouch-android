<!-- app.md T-05: a word the web page also shows belongs to the server and arrives in
     GET /i18n/{lang} → mobile (tabs, empty states, the filter sheet, the picker's chrome).
     A word about the app or the device belongs here and is translated natively: the
     server sheet, connection and address errors, and the standard buttons. -->
<resources>
    <string name="app_name">Splouch</string>

    <!-- Server sheet (app.md P-11..P-13) -->
    <string name="server">Server</string>
