<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- P-12, P-13, P-16: from Android 17 an app targeting 37 reaches a pool's server
         (mDNS browse, `.local` name, private address) only with this runtime grant.
         Asked where the reader reaches for the LAN: `LocalNetworkAccess`. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- app.md N-04: asked at the first swimmer followed, never at launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- No backup, cloud or device-to-device: the default server's /privacy says the settings and
         each server's attendance id (C-10) stay on the device. `allowBackup` covers
         API ≤ 30; from 31 it only stops cloud backup, so the rules file excludes
         everything from both. Lint's ask for `fullBackupContent` too is for API ≤ 30,
         which `allowBackup` already shuts. -->
    <application
        android:name=".SplouchApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:ignore="DataExtractionRules"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Splouch">
        <!-- app.md N-04, N-09: no push token is made before the spectator follows someone.
             `Push.requestToken` turns this on once they have allowed notifications. -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <!-- Heat notifications arrive here as data messages; the app posts them itself, in
             the channel for their kind (`N-06`). -->
        <service
            android:name=".platform.PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- `singleTask`: a QR code scanned while the app is already open reaches the
             running Activity through `onNewIntent`, rather than stacking a second copy of
             the app over the meet the reader was watching. The one `AppModel` lives on the
             Application either way, so a second copy would have shared its state and still
             looked like two apps. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- app.md P-16: `https://splouch.org/add?server=<origin>`, the link a QR code
                 carries. `autoVerify` is what makes the stock camera open the app instead
                 of offering a chooser, and it only holds while
                 `https://splouch.org/.well-known/assetlinks.json` names this package and
                 this signing certificate — see `parity.md` P-16. Without the app installed
                 nothing intercepts the link at all: the browser lands on the page, which
                 is where the Play Store hand-off lives (`P-10`).

                 The host is the app's default server and the path is exact: `pathPrefix`
                 would also swallow `/address` and anything else beginning those four
                 characters. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="splouch.org" android:path="/add" />
            </intent-filter>
        </activity>
    </application>
</manifest>
